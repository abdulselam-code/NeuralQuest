<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NeuralQuest.Controls"
             x:Class="NeuralQuest.OyunPage" BackgroundColor="#030916"
             SafeAreaEdges="None" Shell.NavBarIsVisible="False" Title="Sistem Onarımı">
    <ContentPage.Resources>
        <Style x:Key="OyunDugmesi" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#10253B" />
            <Setter Property="TextColor" Value="#E2F8FF" />
            <Setter Property="BorderColor" Value="#42D9FF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="MinimumWidthRequest" Value="48" />
        </Style>
        <Style x:Key="BilgiBasligi" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextColor" Value="#A8D4EF" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="BilgiDegeri" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#E1F9FF" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid SafeAreaEdges="None">
        <Image Source="background_lab.png" Aspect="AspectFill" InputTransparent="True" />
        <BoxView Color="#B8030916" BackgroundColor="Transparent" InputTransparent="True" />
        <Grid SafeAreaEdges="Container">
            <!-- Normal ekranlarda tüm kartlar görünür; zorunlu küçük boyutlarda içerik kaydırılır. -->
            <ScrollView x:Name="OyunGorunumu" SafeAreaEdges="None" Orientation="Vertical"
                        SizeChanged="Yerlesim_SizeChanged">
                <Grid x:Name="OyunDuzeni" SafeAreaEdges="None" Padding="12,8"
                      RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6">
                    <Grid x:Name="UstAlan" SafeAreaEdges="None" ColumnDefinitions="48,*,96"
                          ColumnSpacing="6" MinimumHeightRequest="48" SizeChanged="Yerlesim_SizeChanged">
                        <Button Text="‹" FontSize="26" Style="{StaticResource OyunDugmesi}"
                                SemanticProperties.Description="Ana menüye dön" Clicked="AnaMenu_Clicked" />
                        <VerticalStackLayout Grid.Column="1" SafeAreaEdges="None" Spacing="1" VerticalOptions="Center">
                            <Label x:Name="ProtokolBasligi" FontSize="15" FontAttributes="Bold" TextColor="#7EEBFF" />
                            <Label x:Name="ProtokolDetayi" FontSize="10" TextColor="#BADAF0" />
                        </VerticalStackLayout>
                        <Button x:Name="DuraklatDugmesi" Grid.Column="2" Text="DURAKLAT" FontSize="11"
                                Style="{StaticResource OyunDugmesi}" Clicked="Duraklat_Clicked" />
                    </Grid>

                    <Grid x:Name="SayacAlani" Grid.Row="1" SafeAreaEdges="None" ColumnDefinitions="*,*,*"
                          MinimumHeightRequest="44" SizeChanged="Yerlesim_SizeChanged">
                        <VerticalStackLayout SafeAreaEdges="None" Spacing="0">
                            <Label Text="SÜRE" Style="{StaticResource BilgiBasligi}" />
                            <Label x:Name="SureLabel" Text="00:00" Style="{StaticResource BilgiDegeri}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" SafeAreaEdges="None" Spacing="0">
                            <Label Text="HAMLE" Style="{StaticResource BilgiBasligi}" />
                            <Label x:Name="HamleLabel" Text="0" Style="{StaticResource BilgiDegeri}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" SafeAreaEdges="None" Spacing="0">
                            <Label Text="KURTARILAN MODÜL" Style="{StaticResource BilgiBasligi}" />
                            <Label x:Name="EslesmeLabel" Text="0 / 6" Style="{StaticResource BilgiDegeri}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid x:Name="OnarimAlani" Grid.Row="2" SafeAreaEdges="None" ColumnDefinitions="48,*"
                          ColumnSpacing="8" MinimumHeightRequest="48" SizeChanged="Yerlesim_SizeChanged">
                        <Image x:Name="CekirdekGorseli" Source="neural_core_split.png" Aspect="AspectFit"
                               HeightRequest="48" WidthRequest="48" InputTransparent="True" />
                        <VerticalStackLayout Grid.Column="1" SafeAreaEdges="None" Spacing="3" VerticalOptions="Center">
                            <Label x:Name="OnarimLabel" Text="ÇEKİRDEK ONARIMI • %0" TextColor="#8BEEFF"
                                   FontSize="12" FontAttributes="Bold" />
                            <ProgressBar x:Name="OnarimCubugu" Progress="0" ProgressColor="#4DE8FF"
                                         BackgroundColor="#19314C" HeightRequest="6" />
                            <Label x:Name="DurumLabel" Text="İki kart açarak modülleri eşleştir."
                                   TextColor="#CFBCF5" FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Ayrılmış alan: sayaçları/kartları kapatmaz, belirdiğinde tahtayı oynatmaz. -->
                    <Grid x:Name="BildirimAlani" Grid.Row="3" SafeAreaEdges="None" MinimumHeightRequest="54"
                          InputTransparent="True" CascadeInputTransparent="True" SizeChanged="Yerlesim_SizeChanged">
                        <Border x:Name="SistemBildirimPaneli" IsVisible="False" Opacity="0"
                                InputTransparent="True" Padding="10,7" Stroke="#6BEAFF" StrokeThickness="1"
                                StrokeShape="RoundRectangle 10" BackgroundColor="#DF0B1830"
                                HorizontalOptions="Fill" VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="#A36BFF" Offset="0,0" Radius="7" Opacity="0.3" />
                            </Border.Shadow>
                            <Label x:Name="SistemBildirimMetni" TextColor="#D6FAFF" FontSize="12"
                                   FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   InputTransparent="True" LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>

                    <!-- Hücreler sabittir; kurtarılan kartların boşlukları korunur. -->
                    <Grid Grid.Row="4" SafeAreaEdges="None">
                        <Grid x:Name="KartAlani" SafeAreaEdges="None" HorizontalOptions="Center"
                              VerticalOptions="Center" ColumnSpacing="5" RowSpacing="5" />
                        <!-- Ortak katman hücrelerin ölçüsünü değiştirmeden iki kartın parçacıklarını çizer. -->
                        <GraphicsView x:Name="KartEfektKatmani" IsVisible="False" InputTransparent="True"
                                      BackgroundColor="Transparent" AutomationProperties.IsInAccessibleTree="False" />
                    </Grid>

                    <Grid x:Name="KontrolAlani" Grid.Row="5" SafeAreaEdges="None" ColumnDefinitions="*,*"
                          ColumnSpacing="8" MinimumHeightRequest="48" SizeChanged="Yerlesim_SizeChanged">
                        <Button x:Name="TaramaDugmesi" Text="SİSTEM TARAMASI" FontSize="11"
                                Style="{StaticResource OyunDugmesi}" Clicked="Tarama_Clicked" />
                        <Button Grid.Column="1" Text="YENİDEN BAŞLAT" FontSize="11"
                                Style="{StaticResource OyunDugmesi}" Clicked="YenidenBaslat_Clicked" />
                    </Grid>
                </Grid>
            </ScrollView>

            <ScrollView x:Name="DuraklatmaKatmani" IsVisible="False" SafeAreaEdges="None" BackgroundColor="#C9030916" ZIndex="10">
                <controls:HudCerceve x:Name="OyunModalPaneli" Margin="12" IcerikPayi="22"
                        MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center">
                  <controls:HudCerceve.Govde>
                    <VerticalStackLayout SafeAreaEdges="None" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="PanelTeknikEtiketi" Text="NQ / KONTROL TERMİNALİ" TextColor="#C7A2FF" FontSize="10" CharacterSpacing="1" />
                            <Label Grid.Column="1" Text="●" TextColor="#67E6FF" FontSize="10" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#345C79" InputTransparent="True" />
                        <Label x:Name="PanelBasligi" Text="SİSTEM DURAKLATILDI" TextColor="#79E9FF" FontSize="22"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="PanelAciklamasi" Text="Onarım işlemi geçici olarak durduruldu."
                               TextColor="#D5E8FA" FontSize="14" HorizontalTextAlignment="Center" />
                        <Button x:Name="PanelBirincil" Text="DEVAM ET" CornerRadius="3" CharacterSpacing="1"
                                Style="{StaticResource OyunDugmesi}" Clicked="PanelBirincil_Clicked" />
                        <Button x:Name="PanelIkincil" Text="YENİDEN BAŞLAT" CornerRadius="3" CharacterSpacing="1"
                                Style="{StaticResource OyunDugmesi}" Clicked="PanelIkincil_Clicked" />
                        <Button x:Name="PanelUcuncul" Text="ANA MENÜ" CornerRadius="3" BackgroundColor="#091426" BorderColor="#536E8D"
                                Style="{StaticResource OyunDugmesi}" Clicked="AnaMenu_Clicked" />
                    </VerticalStackLayout>
                  </controls:HudCerceve.Govde>
                </controls:HudCerceve>
            </ScrollView>

            <ScrollView x:Name="SonucKatmani" IsVisible="False" SafeAreaEdges="None" BackgroundColor="#F5030916">
                <Border x:Name="SonucPaneli" Margin="18" Padding="20" Stroke="#B77AFF"
                        StrokeShape="RoundRectangle 18" BackgroundColor="#10182C"
                        MaximumWidthRequest="440" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout SafeAreaEdges="None" Spacing="12">
                        <Label x:Name="TamamlanmaBasligi" Text="SİSTEM HAFIZASI BAŞARIYLA ONARILDI!" TextColor="#8AF0FF"
                               FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Image Source="neural_core_split.png" Aspect="AspectFit" HeightRequest="72" />
                        <Label x:Name="SonucBilgisi" TextColor="#F1E8FF" FontSize="16"
                               HorizontalTextAlignment="Center" />
                        <Label Text="SİSTEM ONARIMI • %100" TextColor="#76F2CE" FontSize="14"
                               FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="KayitDurumu" TextColor="#B9D9EF" FontSize="12" HorizontalTextAlignment="Center" />
                        <Label Text="Skor: modül başına 1000 puan; fazladan hamle başına 100, aktif saniye başına 5 puan düşülür."
                               TextColor="#B9D9EF" FontSize="11" HorizontalTextAlignment="Center" />
                        <Button Text="YENİDEN OYNA" Style="{StaticResource OyunDugmesi}" Clicked="TekrarOyna_Clicked" />
                        <Button x:Name="SonrakiSeviyeDugmesi" Text="SONRAKİ SEVİYE" Style="{StaticResource OyunDugmesi}"
                                Clicked="SonrakiSeviye_Clicked" />
                        <Button Text="ANA MENÜ" Style="{StaticResource OyunDugmesi}" Clicked="AnaMenu_Clicked" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

