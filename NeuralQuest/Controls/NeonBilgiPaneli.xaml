<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NeuralQuest.Controls"
             x:Class="NeuralQuest.Controls.NeonBilgiPaneli">
    <Grid x:Name="PanelAlani" SafeAreaEdges="Container" BackgroundColor="#D9030916">
      <Grid x:Name="GuvenliPanelAlani" SafeAreaEdges="None" SizeChanged="PanelAlani_SizeChanged">
        <controls:HudCerceve x:Name="Panel" IcerikPayi="20" Margin="12"
                             HorizontalOptions="Center" VerticalOptions="Center">
          <controls:HudCerceve.Govde>
            <Grid SafeAreaEdges="None" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <VerticalStackLayout x:Name="BaslikAlani" SafeAreaEdges="None" Spacing="7" SizeChanged="PanelAlani_SizeChanged">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="NQ / NÖRAL ARŞİV" TextColor="#BCA1E7" FontSize="10" CharacterSpacing="1.5" />
                        <Label Grid.Column="1" Text="● YEREL" TextColor="#66E6D4" FontSize="9" />
                    </Grid>
                    <BoxView Color="#345C79" HeightRequest="1" InputTransparent="True" />
                    <Label x:Name="Baslik" FontSize="23" FontAttributes="Bold" TextColor="#A3F2FF"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="AltBaslik" FontSize="11" TextColor="#ADC9E2" CharacterSpacing="0.5"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <ScrollView x:Name="IcerikKaydirma" Grid.Row="1" SafeAreaEdges="None" VerticalScrollBarVisibility="Default">
                    <VerticalStackLayout x:Name="Icerik" SafeAreaEdges="None" Spacing="10" Padding="0,2,0,4" VerticalOptions="Start"
                                         SizeChanged="PanelAlani_SizeChanged" />
                </ScrollView>
                <Button x:Name="KapatDugmesi" Grid.Row="2" Text="KAPAT" Clicked="Kapat_Clicked"
                        BackgroundColor="#153D53" TextColor="#E8FBFF" FontAttributes="Bold" FontSize="13"
                        CharacterSpacing="1.5" BorderColor="#55DDFF" BorderWidth="1" CornerRadius="3"
                        MinimumHeightRequest="48" MinimumWidthRequest="48" Padding="10,8" />
            </Grid>
          </controls:HudCerceve.Govde>
        </controls:HudCerceve>
      </Grid>
    </Grid>
</ContentView>
